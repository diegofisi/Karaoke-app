{
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "Agent"
    ],
    "deny": [
      "Bash(npm run dev:*)",
      "Bash(npm run tauri dev:*)",
      "Bash(npm run tauri -- dev:*)",
      "Bash(npx tauri dev:*)",
      "Bash(cargo tauri dev:*)",
      "Bash(vite:*)",
      "Bash(npx vite:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)"
    ]
  }
}
