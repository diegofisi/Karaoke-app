{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karaoke",
  "version": "0.2.6",
  "identifier": "com.diegovicuna.karaoke",
  "build": {
    "beforeDevCommand": "npm run binarios && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run binarios && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Karaoke",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/deno",
      "binaries/uv"
    ],
    "resources": {
      "../fabrica/pyproject.toml": "fabrica/pyproject.toml",
      "../fabrica/karaoke_fabrica/*.py": "fabrica/karaoke_fabrica/"
    }
  }
}
